# Salin ke .env (jangan di-commit) dan isi dengan kunci PRIBADI dari penyedia gratis. Tanpa ini, ringkasan memakai templat.
# Gemini (AI Studio, gratis):  https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# Alternatif (format sama, ganti tiga baris di atas):
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.1-8b-instant
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1             LLM_MODEL=qwen2.5:3b   (tanpa kunci, data tidak keluar komputer)

# Opsional: LLM_TIMEOUT_S=25  LLM_MAX_PER_MIN=8
